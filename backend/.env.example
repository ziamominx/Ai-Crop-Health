# --- Agricure backend environment — copy to .env and edit ---
# NEVER commit a real .env file.

# --- App ---
DEBUG=true

# --- Database ---
# PostgreSQL (default). Create the DB first:
#   createdb agricure   (or use pgAdmin / psql)
DATABASE_URL=postgresql+psycopg://agricure:agricure@localhost:5432/agricure
# Zero-setup SQLite fallback for quick academic demos:
# DATABASE_URL=sqlite:///./agricure_dev.db

# --- Security ---
# Generate a real key with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- CORS (comma-separated frontend origins) ---
# When deploying (e.g. Vercel) add your real frontend origin:
# CORS_ORIGINS=https://ai-crop-health.vercel.app,http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- AI model ---
# DEMO_MODEL = deterministic simulated inference, clearly labelled as demo (default)
# REAL_MODEL = load a trained Keras model from MODEL_PATH
AI_MODE=DEMO_MODEL
# MODEL_PATH=./ml/weights/agricure_crop_disease.keras
# MODEL_LABELS_PATH=./ml/weights/labels.txt
MODEL_VERSION=demo-v0

# --- Weather ---
# DEMO_WEATHER = labelled sample data (default) | OPENWEATHER = real API
WEATHER_MODE=DEMO_WEATHER
# OPENWEATHER_API_KEY=your-openweather-key

# --- Image storage: LOCAL (demo fallback) | SUPABASE | CLOUDINARY ---
STORAGE_PROVIDER=LOCAL
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=8
PUBLIC_BASE_URL=http://localhost:8000

# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_KEY=your-service-key
# SUPABASE_BUCKET=agricure-crop-images
# CLOUDINARY_CLOUD_NAME=your-cloud
# CLOUDINARY_API_KEY=your-key
# CLOUDINARY_API_SECRET=your-secret

# --- Demo mode ---
DEMO_MODE=true
DEMO_SEED_TAG=DEMO
DEMO_FARMER_EMAIL=demo@agricure.app
DEMO_FARMER_PASSWORD=demo1234
DEMO_OFFICER_EMAIL=officer@agricure.gov.in
DEMO_OFFICER_PASSWORD=officer1234
DEMO_ADMIN_EMAIL=admin@agricure.gov.in
DEMO_ADMIN_PASSWORD=admin1234
